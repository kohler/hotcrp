#! /bin/bash
## hotcrp-scanctl -- run HotCRP inside the OSS Scanner image
## Copyright (c) 2006-2026 Eddie Kohler; see LICENSE.

SRC=/src
PORT="${HOTCRP_PORT:-8080}"
SITE="http://localhost:$PORT"
LISTEN=127.0.0.1
PASSWORD=test1234
export HOTCRP_MAILDIR="${HOTCRP_MAILDIR:-/var/spool/hotcrp-mail}"
LOGDIR=/var/log/hotcrp-scanctl
RUNDIR=/run/hotcrp-scanctl
ETCDIR=/etc/hotcrp-scanctl
DBUSER=hotcrp_web
DBPASS=hotcrp-web-x7Pq
CDBNAME=hotcrp_cdb
DOCSTORE=/var/lib/hotcrp/docs

usage () {
    cat <<__EOF__
Usage: hotcrp-scanctl COMMAND [ARGS]

The image has no init system and no network; start what you need yourself.

Commands:
  start [--public] [--minimal]
               Start MariaDB, php-fpm, and nginx, serving two conferences at
               $SITE/conf1/ and $SITE/conf2/. \`--public\` listens on
               all interfaces, for a browser on the host; run the container
               with \`-p $PORT:$PORT\`. \`--minimal\` first resets to
               minimal conferences (see \`reset\`).
  stop         Stop nginx, php-fpm, and MariaDB
  status       Report what is running
  reset [--minimal]
               Rebuild both conferences' databases. By default they are
               populated as if mid-review: reviews, comments, responses,
               decisions, tags, votes, a track, preferences. \`--minimal\`
               leaves only accounts, papers, and review assignments.
  test [ARGS]  Start MariaDB and run \`php test/run.php ARGS\` (unit tests)
  db [CONFID]  Start MariaDB and open a SQL shell on conf1 (or CONFID)
  mail         List outgoing mail captured by the fake sendmail
  setup        (Build time only) create the databases and configuration

Every account's password is \`$PASSWORD\`. The conferences share a contact
database ($CDBNAME), so an account in both has the same password.
  conf1        the test fixture test/db.json: 30 papers, reviews, tags
               chair@_.com and chair2@z.edu are chairs (chair2 is conflicted
               with #20, whose administrator is marina@poema.ru);
               marina@poema.ru, estrin@usc.edu,
               ... are PC members; vern@ee.lbl.gov, ... are authors
  conf2        two papers; vern@ee.lbl.gov is the chair, marina@poema.ru and
               anja@research.att.com are PC members
Batch scripts take the conference as \`-n CONFID\`, e.g.,
\`php batch/apitoken.php -n conf1 create -u marina@poema.ru\`.

Files:
  $SRC/conf/options.php     multiconference options (databases conf1, conf2)
  $SRC/test/options.php     test-suite options (database hotcrp_testdb)
  $DOCSTORE/conf1  conf1's document store (conf2 stores
                              documents in its database)
  $HOTCRP_MAILDIR      captured outgoing mail, one .eml per message;
                              to/ADDRESS/ links each message per recipient
  $LOGDIR       mariadb.log, php-fpm.log, nginx-*.log
__EOF__
}

db_running () {
    mariadb-admin ping >/dev/null 2>&1
}

db_start () {
    db_running && return 0
    mkdir -p /run/mysqld "$LOGDIR"
    chown mysql:mysql /run/mysqld
    /usr/sbin/mariadbd --user=mysql >>"$LOGDIR/mariadb.log" 2>&1 </dev/null &
    for i in $(seq 1 120); do
        db_running && return 0
        sleep 0.5
    done
    echo "hotcrp-scanctl: MariaDB did not start; see $LOGDIR/mariadb.log" 1>&2
    exit 1
}

db_stop () {
    db_running && mariadb-admin shutdown
}

pid_running () {
    test -f "$1" && kill -0 "`cat "$1"`" 2>/dev/null
}

web_start () {
    mkdir -p "$RUNDIR" "$LOGDIR" "$HOTCRP_MAILDIR"
    chmod 1777 "$HOTCRP_MAILDIR"
    own_docstore
    if ! pid_running "$RUNDIR/php-fpm.pid"; then
        `ls /usr/sbin/php-fpm* | head -n 1` -y "$ETCDIR/php-fpm.conf" || exit 1
    fi
    sed "s/@LISTEN@/$LISTEN/; s/@PORT@/$PORT/" "$ETCDIR/nginx.conf.in" > "$RUNDIR/nginx.conf"
    if pid_running "$RUNDIR/nginx.pid"; then
        nginx -c "$RUNDIR/nginx.conf" -s reload
    else
        nginx -c "$RUNDIR/nginx.conf" || exit 1
    fi
    for i in $(seq 1 40); do
        curl -s -o /dev/null "$SITE/conf1/" && return 0
        sleep 0.25
    done
    echo "hotcrp-scanctl: web server did not start; see $LOGDIR" 1>&2
    exit 1
}

web_stop () {
    pid_running "$RUNDIR/nginx.pid" && nginx -c "$RUNDIR/nginx.conf" -s quit
    pid_running "$RUNDIR/php-fpm.pid" && kill "`cat "$RUNDIR/php-fpm.pid"`"
}

write_config () {
    mkdir -p "$SRC/conf" "$ETCDIR"
    cat > "$SRC/conf/options.php" <<__EOF__
<?php
// conf/options.php -- sample conferences for the OSS Scanner image
// Generated by \`hotcrp-scanctl setup\`; see devel/oss-scanner.
// The conference ID is the first URL path component; it is also the
// database name. conf/CONFID.php holds per-conference options.
global \$Opt;
\$Opt["multiconference"] = true;
\$Opt["sessionName"] = "hotcrp";      // one sign-in covers both conferences
\$Opt["dbUser"] = "$DBUSER";
\$Opt["dbPassword"] = "$DBPASS";
\$Opt["contactdbDsn"] = "mysql://$DBUSER:$DBPASS@localhost/$CDBNAME";
\$Opt["include"][] = '?conf/\${confid}.php';
\$Opt["paperSite"] = '$SITE/\${confid}/';
\$Opt["emailFrom"] = "hotcrp@localhost";
\$Opt["sendEmail"] = true;
\$Opt["timezone"] = "America/New_York";
\$Opt["updatesSite"] = false;
__EOF__
    cat > "$SRC/conf/conf1.php" <<'__EOF__'
<?php
global $Opt;
$Opt["shortName"] = "Testconf I";
$Opt["longName"] = "Test Conference I";
$Opt["contactName"] = "Jane Chair";
$Opt["contactEmail"] = "chair@_.com";
$Opt["docstore"] = "@DOCSTORE@/conf1/%2h/%h%x";
$Opt["dbNoPapers"] = true;
__EOF__
    sed -i "s,@DOCSTORE@,$DOCSTORE," "$SRC/conf/conf1.php"
    cat > "$SRC/conf/conf2.php" <<'__EOF__'
<?php
global $Opt;
$Opt["shortName"] = "Testconf II";
$Opt["longName"] = "Test Conference II";
$Opt["contactName"] = "Vern Paxson";
$Opt["contactEmail"] = "vern@ee.lbl.gov";
__EOF__

    cat > "$ETCDIR/php-fpm.conf" <<__EOF__
[global]
pid = $RUNDIR/php-fpm.pid
error_log = $LOGDIR/php-fpm.log
daemonize = yes

[hotcrp]
user = www-data
group = www-data
listen = $RUNDIR/php-fpm.sock
listen.owner = www-data
listen.group = www-data
pm = dynamic
pm.max_children = 8
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
catch_workers_output = yes
decorate_workers_output = no
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[HOTCRP_MAILDIR] = $HOTCRP_MAILDIR
php_admin_value[sendmail_path] = /usr/local/bin/hotcrp-sendmail
php_admin_value[memory_limit] = 512M
php_admin_value[max_execution_time] = 30
php_admin_value[upload_max_filesize] = 15M
php_admin_value[post_max_size] = 20M
php_admin_value[max_input_vars] = 4096
php_admin_value[error_reporting] = 32767
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
__EOF__

    cat > "$ETCDIR/nginx.conf.in" <<__EOF__
user www-data;
worker_processes 2;
pid $RUNDIR/nginx.pid;
error_log $LOGDIR/nginx-error.log;
events {}
http {
    access_log $LOGDIR/nginx-access.log;
    client_max_body_size 20m;
    server {
        listen @LISTEN@:@PORT@;
        server_name localhost;
        location = / {
            return 302 /conf1/;
        }
        location / {
            fastcgi_pass unix:$RUNDIR/php-fpm.sock;
            fastcgi_split_path_info ^(/[^/]*)(/[\s\S]*)?\$;
            fastcgi_param SCRIPT_FILENAME $SRC/index.php;
            include /etc/nginx/fastcgi_params;
            # Debian's fastcgi_params drops the port from HTTP_HOST
            fastcgi_param HTTP_HOST \$host:\$server_port;
        }
    }
}
__EOF__
}

fresh_schema () {
    mariadb -e "drop database if exists $1; create database $1 default character set utf8mb4" \
        && mariadb "$1" < "$SRC/src/schema.sql"
}

seed () {
    rm -rf "$HOTCRP_MAILDIR" "$DOCSTORE"
    own_docstore \
        && fresh_schema conf1 \
        && php "$SRC/devel/oss-scanner/seed.php" $1 conf1 fixture "$PASSWORD" \
        && fresh_schema conf2 \
        && php "$SRC/devel/oss-scanner/seed.php" $1 conf2 small "$PASSWORD" \
        && own_docstore
}

# HotCRP uses a docstore only if its directory exists. Seeding and batch
# scripts run as root; php-fpm runs as www-data.
own_docstore () {
    mkdir -p "$DOCSTORE/conf1" && chown -R www-data:www-data "$DOCSTORE"
}

cmd_setup () {
    set -e
    db_start
    cd "$SRC"
    lib/createdb.sh -u root -c test/options.php --batch --replace
    lib/createdb.sh -u root -c test/cdb-options.php --no-dbuser --no-schema --batch --replace
    write_config
    mariadb <<__EOF__
CREATE DATABASE IF NOT EXISTS $CDBNAME DEFAULT CHARACTER SET utf8mb4;
CREATE USER IF NOT EXISTS '$DBUSER'@'localhost' IDENTIFIED BY '$DBPASS';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, INDEX, REFERENCES, ALTER,
    LOCK TABLES, CREATE TEMPORARY TABLES ON conf1.* TO '$DBUSER'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, INDEX, REFERENCES, ALTER,
    LOCK TABLES, CREATE TEMPORARY TABLES ON conf2.* TO '$DBUSER'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, INDEX, REFERENCES, ALTER,
    LOCK TABLES, CREATE TEMPORARY TABLES ON $CDBNAME.* TO '$DBUSER'@'localhost';
GRANT RELOAD ON *.* TO '$DBUSER'@'localhost';
__EOF__
    seed
    db_stop
}

cmd_start () {
    minimal=
    for arg; do
        case "$arg" in
        --public) LISTEN=0.0.0.0;;
        --minimal) minimal=--minimal;;
        *) usage 1>&2; exit 1;;
        esac
    done
    db_start
    if [ -n "$minimal" ]; then
        (cd "$SRC" && seed --minimal) || exit 1
    fi
    web_start
    echo "HotCRP is serving $SITE/conf1/ and $SITE/conf2/"
    echo "Every account's password is $PASSWORD; \`hotcrp-scanctl help\` lists accounts"
}

cmd_status () {
    if db_running; then echo "MariaDB: running"; else echo "MariaDB: stopped"; fi
    if pid_running "$RUNDIR/php-fpm.pid"; then echo "php-fpm: running"; else echo "php-fpm: stopped"; fi
    if pid_running "$RUNDIR/nginx.pid"; then echo "nginx: $SITE/"; else echo "nginx: stopped"; fi
}

cmd_mail () {
    ls -1 "$HOTCRP_MAILDIR"/*.eml 2>/dev/null | while read f; do
        echo "$f: `grep -m1 '^To:' "$f"` `grep -m1 '^Subject:' "$f"`"
    done
    if [ -d "$HOTCRP_MAILDIR/to" ]; then
        echo "Recipients:" `ls -A "$HOTCRP_MAILDIR/to"`
    fi
}

cmd=${1:-help}
shift
case "$cmd" in
setup)  cmd_setup;;
start)  cmd_start "$@";;
stop)   web_stop; db_stop;;
status) cmd_status;;
reset)  case "${1:-}" in
        ""|--minimal) db_start; cd "$SRC" && seed $1;;
        *) usage 1>&2; exit 1;;
        esac;;
test)   db_start; cd "$SRC" && php -d error_reporting=E_ALL test/run.php "$@";;
db)     db_start; exec mariadb "${1:-conf1}";;
mail)   cmd_mail;;
help|-h|--help) usage;;
*)      usage 1>&2; exit 1;;
esac
